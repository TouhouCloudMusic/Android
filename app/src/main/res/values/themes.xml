<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TouhouCloudMusic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/system_accent</item>
        <item name="colorPrimaryDark">@color/system_accent_darker</item>
        <item name="colorSecondary">@color/system_accent_2</item>

        <item name="colorError">@color/error</item>

        <item name="colorPrimaryVariant">@color/system_accent</item>
        <item name="colorSecondaryVariant">@color/system_accent_2</item>
        <item name="scrimBackground">@color/netrual_color</item>

        <item name="colorSurface">@color/netrual_color</item>
        <item name="colorSecondaryContainer">@color/system_accent_soft</item>
    </style>

    <style name="Theme.TouhouCloudMusic" parent="Base.Theme.TouhouCloudMusic">
        <item name="android:colorBackground">@color/background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.TouhouCloudMusic.Search" parent="Theme.TouhouCloudMusic">
        <!-- 启用内容过渡 -->
        <item name="android:windowContentTransitions">true</item>
        <!-- 设置共享元素过渡动画 -->
        <item name="android:windowSharedElementEnterTransition">@transition/search_transition</item>
        <item name="android:windowSharedElementExitTransition">@transition/search_transition</item>
    </style>

    <style name="UserAvatarCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="BannerImageRoundRect">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>

    <style name="UserCard_UserSubText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="UserCard_UserProfileEditButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:src">@drawable/ic_edit_profile</item>
        <item name="android:layout_margin">4dp</item>
    </style>
</resources>