<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 基础应用主题 -->
    <style name="Base.Theme.TouhouCloudMusic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主要颜色 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        
        <!-- 次要颜色 -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        
        <!-- 表面颜色 -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        
        <!-- 背景颜色 -->
        <item name="android:colorBackground">@color/background</item>
        
        <!-- 文字颜色 -->
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- 功能颜色 -->
        <item name="colorError">@color/error</item>
        
        <!-- 分割线 -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
    </style>

    <!-- 主应用主题 -->
    <style name="Theme.TouhouCloudMusic" parent="Base.Theme.TouhouCloudMusic">
        <!-- 状态栏和导航栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- 搜索页面主题 -->
    <style name="Theme.TouhouCloudMusic.Search" parent="Theme.TouhouCloudMusic">
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowSharedElementEnterTransition">@transition/search_transition</item>
        <item name="android:windowSharedElementExitTransition">@transition/search_transition</item>
    </style>

    <!-- 底部弹窗主题 -->
    <style name="BottomSheetDialogTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:listPreferredItemPaddingStart">24dp</item>
        <item name="android:listPreferredItemPaddingEnd">16dp</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="bottomSheetStyle">@style/BottomSheet</item>
    </style>

    <style name="BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/sheet_background</item>
    </style>

    <!-- 通用组件样式 -->
    <style name="UserAvatarCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="BannerImageRoundRect">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>

    <!-- 用户卡片样式 -->
    <style name="UserCard_UserSubText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="UserCard_UserProfileEditButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:src">@drawable/ic_edit_profile</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- No elements styles -->
    <style name="Theme.TouhouCloudMusic.NoElements" />

    <style name="Theme.TouhouCloudMusic.NoElements.LinearLayout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Theme.TouhouCloudMusic.NoElements.ImageView">
        <item name="android:layout_width">140dp</item>
        <item name="android:layout_height">140dp</item>
    </style>

    <style name="Theme.TouhouCloudMusic.NoElements.Space">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">8dp</item>
    </style>

    <style name="Theme.TouhouCloudMusic.NoElements.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 播放栏样式 -->
    <style name="Theme.TouhouCloudMusic.NowPlayingBar.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/NowPlayingBarCardShape</item>
        <item name="android:clickable">true</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <style name="NowPlayingBarCardShape" parent="ShapeAppearanceOverlay.Material3.Corner.Top">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
    </style>

    <!-- 评分条样式 -->
    <style name="Theme.TouhouCloudMusic.RatingBar" parent="Widget.AppCompat.RatingBar.Indicator">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:numStars">5</item>
        <item name="android:stepSize">0.5</item>
        <item name="android:scaleX">0.8</item>
        <item name="android:scaleY">0.8</item>
        <item name="android:isIndicator">false</item>
        <item name="android:tint">@color/primary</item>
    </style>
</resources>