<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TouhouCloudMusic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/system_accent</item>
        <item name="colorPrimaryDark">@color/system_accent_darker</item>
        <item name="colorSecondary">@color/system_accent_2</item>

        <item name="colorError">@color/error</item>

        <item name="colorPrimaryVariant">@color/system_accent</item>
        <item name="colorSecondaryVariant">@color/system_accent_2</item>
        <item name="scrimBackground">@color/netrual_color</item>

        <item name="colorSurface">@color/netrual_color</item>
        <item name="colorSecondaryContainer">@color/system_accent_soft</item>
    </style>

    <style name="Theme.TouhouCloudMusic" parent="Base.Theme.TouhouCloudMusic">
        <item name="android:colorBackground">@color/background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.TouhouCloudMusic.Search" parent="Theme.TouhouCloudMusic">
        <!-- 启用内容过渡 -->
        <item name="android:windowContentTransitions">true</item>
        <!-- 设置共享元素过渡动画 -->
        <item name="android:windowSharedElementEnterTransition">@transition/search_transition</item>
        <item name="android:windowSharedElementExitTransition">@transition/search_transition</item>
    </style>

    <style name="UserAvatarCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="BannerImageRoundRect">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>

    <style name="UserCard_UserSubText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="UserCard_UserProfileEditButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:src">@drawable/ic_edit_profile</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- No elements styles -->
    <style name="Theme.TouhouCloudMusic.NoElements" />

    <style name="Theme.TouhouCloudMusic.NoElements.LinearLayout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Theme.TouhouCloudMusic.NoElements.ImageView">
        <item name="android:layout_width">140dp</item>
        <item name="android:layout_height">140dp</item>
    </style>

    <style name="Theme.TouhouCloudMusic.NoElements.Space">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">8dp</item>
    </style>

    <style name="Theme.TouhouCloudMusic.NoElements.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Now playing bar -->
    <style name="Theme.TouhouCloudMusic.NowPlayingBar.CardView" parent="@style/Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">
            @style/Theme.TouhouCloudMusic.NowPlayingBar.CardView.ShapeAppearanceOverlay
        </item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Theme.TouhouCloudMusic.NowPlayingBar.CardView.ShapeAppearanceOverlay" parent="@style/ShapeAppearanceOverlay.Material3.Corner.Top">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
    </style>

    <!-- RatingBar -->
    <style name="Theme.TouhouCloudMusic.RatingBar" parent="@style/Widget.AppCompat.RatingBar.Indicator">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:numStars">5</item>
        <item name="android:stepSize">0.5</item>
        <item name="android:scaleX">0.8</item>
        <item name="android:scaleY">0.8</item>
        <item name="android:isIndicator">false</item>
        <item name="android:tint">@color/system_accent</item>
        <item name="minHeight">40dp</item>
        <item name="maxHeight">40dp</item>
        <item name="minWidth">10dp</item>
        <item name="maxWidth">10dp</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>